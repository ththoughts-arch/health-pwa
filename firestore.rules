rules_version = '2';

// 구조: docs/data-model.md
// 모든 데이터는 users/{uid}/ 아래 → 본인만 접근. 이 구조면 나중에 다중 사용자로 그대로 확장 가능.
// 2026-10-26: 앱의 동기화 버튼이 직접 수집·저장하므로 days·activities도 본인 쓰기 허용.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /days/{date} {
        allow read, write: if isOwner(uid);
      }
      match /activities/{activityId} {
        allow read, write: if isOwner(uid);
      }
      match /checkins/{date} {
        allow read, write: if isOwner(uid);
      }
      match /supplements/{supplementId} {
        allow read, write: if isOwner(uid);
      }
      match /strength/{entryId} {
        allow read, write: if isOwner(uid);
      }
      match /memos/{memoId} {
        allow read, write: if isOwner(uid);
      }
      // AI 코칭 결과 (exercise 등)
      match /coach/{docId} {
        allow read, write: if isOwner(uid);
      }
      // intervals.icu·Gemini API 키
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /pushSubscriptions/{subId} {
        allow read, write: if isOwner(uid);
      }
    }

    // 그 외 경로는 모두 차단 (목록에 없는 하위 컬렉션 포함)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
