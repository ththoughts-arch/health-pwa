rules_version = '2';

// 구조: docs/data-model.md
// 모든 데이터는 users/{uid}/ 아래 → 본인만 접근. 이 구조면 나중에 다중 사용자로 그대로 확장 가능.
// GitHub Actions는 서비스 계정(Admin SDK)으로 쓰므로 이 규칙과 무관하게 기록된다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Actions가 쓰는 데이터: 앱은 읽기만
      match /days/{date} {
        allow read: if isOwner(uid);
      }
      match /activities/{activityId} {
        allow read: if isOwner(uid);
      }

      // 사용자가 직접 입력하는 데이터
      match /checkins/{date} {
        allow read, write: if isOwner(uid);
      }
      match /supplements/{supplementId} {
        allow read, write: if isOwner(uid);
      }
      match /strength/{entryId} {
        allow read, write: if isOwner(uid);
      }
      match /pushSubscriptions/{subId} {
        allow read, write: if isOwner(uid);
      }
    }

    // 그 외 경로는 모두 차단 (목록에 없는 하위 컬렉션 포함)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
